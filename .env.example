# Database Configuration
# Get these from your Supabase/PostgreSQL provider dashboard
DATABASE_URL=postgresql://user:password@host:5432/database
# For Supabase transaction mode (6543), use: ?pgbouncer=true&connection_limit=5&pool_timeout=20
# IMPORTANT: connection_limit must be >1. A limit of 1 means the whole app
# can only run ONE database query at a time - any page or action that
# fires more than one query concurrently (the admin dashboard does 6+ at
# once) will queue up and hit "Timed out fetching a new connection from
# the connection pool" (Prisma error P2024). 5 is a reasonable starting
# point for a small Supabase project; raise it if you still see timeouts
# under real traffic, but don't set it to 1.
DIRECT_URL=postgresql://user:password@host:5432/database

# Server Configuration
PORT=3000

# Clerk Authentication (https://dashboard.clerk.com)
# IMPORTANT: Use pk_live_* and sk_live_* keys in production, NOT pk_test_*
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_aGFybWxlc3Mta3JpbGwtMzAuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=sk_test_vwv4S9k8I1jnkHNgb1RKoexqwoFu1otm1zlpwDWtqP

# Clerk Redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

