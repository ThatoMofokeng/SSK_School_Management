# Copy this file to .env and fill in real values. Never commit .env.

# Database (used by docker-compose.yml to configure the postgres container
# AND by Prisma's DATABASE_URL/DIRECT_URL)
DB_USER=changeme
DB_PASSWORD=changeme
DB_NAME=ssk_school

# Prisma connection strings (Render/Azure inject these at runtime)
DATABASE_URL=postgresql://changeme:changeme@localhost:5432/ssk_school?schema=public
DIRECT_URL=postgresql://changeme:changeme@localhost:5432/ssk_school?schema=public

# Server port (Render sets PORT automatically; defaults to 3000 locally)
PORT=3000

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
